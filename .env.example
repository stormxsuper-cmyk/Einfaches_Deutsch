# Einfaches Deutsch — local environment
# Copy this file to `.env` and fill in the values. It is read by docker compose.

# PostgreSQL (local Docker database)
POSTGRES_PASSWORD=local_dev_password_change_me

# Supabase project (accounts + JWT verification on the API)
# Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- deployment ---
# Behind a proxy (Railway, Fly, Heroku, nginx) so rate limiting sees real client IPs.
TRUST_PROXY=1
# Comma-separated list of allowed browser origins for CORS. Only needed when the
# frontend is deployed as a SEPARATE service/domain from the API.
FRONTEND_ORIGIN=
# The API refuses to start in production without authentication. Set to 1 ONLY for a
# public-content deployment (curriculum + demo mode); account routes then return 503.
ALLOW_UNAUTHENTICATED=
# Where the built frontend lives. Defaults to <repo>/frontend/dist.
WEB_DIST=
