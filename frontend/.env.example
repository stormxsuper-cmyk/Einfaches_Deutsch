# Frontend environment — copy to `frontend/.env.local` (or set as container env vars).
# Vite only exposes variables prefixed with VITE_ to the browser.

# Leave empty to use the same origin (`/api`), which Vite proxies to the backend.
VITE_API_URL=

# Required for accounts. Without both values the app shows
# "Accounts are not configured" instead of the sign-in form.
# Supabase project -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
